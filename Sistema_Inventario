Console.WriteLine("\t¡Bienvenido al sistema de inventario!");
    //Declaramos las variables que vamos a usar
string nombre;
decimal precio;
int cantidad;

    //Solicitamos al usuario ingresar la informacion
Console.Write("Ingrese el nombre del producto: ");
nombre = Console.ReadLine() ?? "";
    // ?? "" - Determina que si el usuario no ingresa un dato queda un texto vacio

Console.Write("Ingrese el precio del producto: ");
string entradaPrecio = Console.ReadLine() ?? "";
bool precioValido = decimal.TryParse(entradaPrecio, out precio);
    // La variable bool nos permite identificar si la conversión del dato fue exitosa.
    // decimal.TryParse intenta convertir el texto ingresado por el usuario en un número decimal.

Console.Write("Ingrese la cantidad del producto: ");
string entradaCantidad = Console.ReadLine() ?? "";
bool cantidadValida = int.TryParse(entradaCantidad, out cantidad);


    // Nombre no puede quedar vacio
if (string.IsNullOrWhiteSpace(nombre))
{
    Console.WriteLine("Registro rechazado: el nombre del producto no puede quedar vacío.");
}
    // Precio no puede ser negativo
if (precio < 0)
{
    Console.WriteLine("Registro rechazado: el precio no puede ser negativo.");
}
    // Cantidad maxima de 1000 unidades
if (cantidad > 1000)
{
    Console.WriteLine("Registro rechazado: la cantidad no puede superar las 1000 unidades.");
}
else
{
    Console.WriteLine("\n¡Registro válido!");
    Console.WriteLine($"Registraste \"{nombre}\" con un valor de {precio} y se encuentrasn disponibles {cantidad} unidades.");
}
